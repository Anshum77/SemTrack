<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="16dp">

            <!-- Course Name Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/tv_course_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.01"
                    android:textColor="?attr/colorOnSurface" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp">

                <!-- ===== STATS CARD ===== -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Large">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_stats_card"
                        android:padding="20dp">

                        <!-- Row 1: Present / Absent -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tv_present_count"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="32sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/attendance_green" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/attendance_present_label"
                                    android:textSize="13sp"
                                    android:letterSpacing="0.04"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:layout_marginTop="2dp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tv_absent_count"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="32sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/attendance_red" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/attendance_absent_label"
                                    android:textSize="13sp"
                                    android:letterSpacing="0.04"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:layout_marginTop="2dp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Subtle divider -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="16dp"
                            android:background="?attr/colorOutlineVariant"
                            android:alpha="0.3" />

                        <!-- Row 2: Total / Percentage -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tv_total_count"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="32sp"
                                    android:textStyle="bold"
                                    android:textColor="?attr/colorOnSurface" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/attendance_total_label"
                                    android:textSize="13sp"
                                    android:letterSpacing="0.04"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:layout_marginTop="2dp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tv_attendance_percent"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="32sp"
                                    android:textStyle="bold"
                                    android:textColor="?attr/colorOnSurface" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/attendance_percent_label"
                                    android:textSize="13sp"
                                    android:letterSpacing="0.04"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:layout_marginTop="2dp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ===== SAFE SKIPS / REQUIRED CLASSES CARD ===== -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_safe_skips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Large">

                    <LinearLayout
                        android:id="@+id/ll_safe_skips_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_safe_skips_card"
                        android:padding="18dp">

                        <ImageView
                            android:id="@+id/iv_safe_skips_icon"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_shield_check"
                            android:contentDescription="Safe skips icon"
                            app:tint="@color/white" />

                        <TextView
                            android:id="@+id/tv_safe_skips_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/white" />

                        <TextView
                            android:id="@+id/tv_safe_skips_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/attendance_safe_skips_placeholder"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            android:textColor="@color/white" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ===== MARK ATTENDANCE CARD ===== -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Large">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_mark_section_card"
                        android:padding="18dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_pick_date"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            app:icon="@drawable/ic_calendar_today"
                            app:iconPadding="10dp"
                            app:iconGravity="textStart"
                            app:cornerRadius="16dp"
                            app:strokeColor="?attr/colorOutlineVariant"
                            android:textSize="15sp"
                            android:text="@string/attendance_pick_date" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="14dp">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_mark_present"
                                style="@style/Widget.Material3.Button"
                                android:layout_width="0dp"
                                android:layout_height="52dp"
                                android:layout_weight="1"
                                android:textColor="@color/white"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:text="@string/attendance_mark_present"
                                app:icon="@drawable/ic_check_circle"
                                app:iconTint="@color/white"
                                app:iconGravity="textStart"
                                app:iconPadding="6dp"
                                app:backgroundTint="@color/attendance_green"
                                app:rippleColor="#40FFFFFF"
                                app:cornerRadius="28dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_mark_absent"
                                style="@style/Widget.Material3.Button"
                                android:layout_width="0dp"
                                android:layout_height="52dp"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:textColor="@color/white"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:text="@string/attendance_mark_absent"
                                app:icon="@drawable/ic_cancel_circle"
                                app:iconTint="@color/white"
                                app:iconGravity="textStart"
                                app:iconPadding="6dp"
                                app:backgroundTint="@color/attendance_red"
                                app:rippleColor="#40FFFFFF"
                                app:cornerRadius="28dp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ===== VIEW HISTORY BUTTON ===== -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_view_history"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="14dp"
                    app:icon="@drawable/ic_history"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:cornerRadius="16dp"
                    android:text="@string/attendance_view_history" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
